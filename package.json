    "clsx": "^2.1.1",
    "framer-motion": "^14.9.0",
    "lenis": "^1.3.27",
    "lucide-react": "^1.66.0",
    "next": "16.4.3",
    "next-themes": "^0.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "^7.91.0",
    "tailwind-merge": "^3.7.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
