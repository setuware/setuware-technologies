# Copy to /etc/setuware.env on the server:
#   sudo cp deploy/setuware.env.example /etc/setuware.env
#   sudo chown root:ubuntu /etc/setuware.env && sudo chmod 640 /etc/setuware.env
# then fill in the values. Restart after changes:  sudo systemctl restart setuware
# (NEXT_PUBLIC_* values need a redeploy because they are built into the site.)

NEXT_PUBLIC_SITE_URL=https://setuware.in

# Google Search Console "HTML tag" verification code (content="…" only).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Website enquiries -------------------------------------------------------
# E-mail every enquiry (contact form, chatbot, pop-up, estimator) via SMTP.
# Zoho Mail India: smtp.zoho.in:465 · Google Workspace: smtp.gmail.com:465
# Use an app password, not your normal login password.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
LEAD_EMAIL_TO=sales@setuware.in
# Must be the same mailbox as SMTP_USER (Zoho rejects other senders).
LEAD_EMAIL_FROM="Setuware Technologies <sales@setuware.in>"
# Thank-you e-mail to the visitor after each enquiry/estimate (true/false).
LEAD_SEND_ACK=true
# Test these settings on the server:  npm run mail:test

# --- Zoho CRM (CRM Plus) ----------------------------------------------------
# Each enquiry (not newsletter sign-ups) becomes a Lead. Setup: docs/zoho-crm.md
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# India data centre; use accounts.zoho.com / www.zohoapis.com etc. elsewhere.
ZOHO_ACCOUNTS_URL=https://accounts.zoho.in
ZOHO_API_DOMAIN=https://www.zohoapis.in
# Must exist in Leads → Lead Source picklist (falls back to blank if missing).
ZOHO_LEAD_SOURCE=Website
# Check:  npm run crm:test   (add  -- --create  for one test lead)

# Optional: also POST each enquiry as JSON to a webhook (Slack, a CRM,
# Google Sheets via Apps Script, Zapier, Make, n8n …).
LEAD_WEBHOOK_URL=

# Cap build memory on small VMs (MB). The deploy script reads this.
BUILD_MEMORY_MB=1536
